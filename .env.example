# Chat agents (Foundry project endpoint and a deployed chat model)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4o-mini
# Microsoft-Decision-1 (resource endpoint and the deployment name)
FOUNDRY_RESOURCE_ENDPOINT=https://<account>.services.ai.azure.com
DECISION_DEPLOYMENT=<decision-1 deployment name>
# Optional: publish events to Azure Event Hubs (also needs `uv add azure-eventhub`; auth via az login)
EVENTHUB_NAMESPACE=<namespace>.servicebus.windows.net
EVENTHUB_NAME=<event hub name>
